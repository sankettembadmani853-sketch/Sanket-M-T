import java.util.Scanner;

public class Solution {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Accept comma or whitespace as input separator
        sc.useDelimiter("\\s*,\\s*|\\s+");

        int studentId = sc.nextInt();
        String studentName = sc.next();

        int[] attendance = new int[7];

        int presentDays = 0;
        int absentDays = 0;
        boolean validInput = true;

        // Read attendance for 7 days
        for (int i = 0; i < 7; i++) {

            attendance[i] = sc.nextInt();

            // Check whether attendance is only 0 or 1
            if (attendance[i] != 0 && attendance[i] != 1) {
                validInput = false;
            }

            if (attendance[i] == 1) {
                presentDays++;
            } 
            else if (attendance[i] == 0) {
                absentDays++;
            }
        }

        // Display result
        if (!validInput) {

            System.out.println("Invalid Attendance Input");

        } else {

            double attendancePercentage =
                    ((double) presentDays / 7) * 100;

            System.out.printf(
                    "Attendance = %.2f%%, Absent Days = %d",
                    attendancePercentage,
                    absentDays
            );

            if (attendancePercentage >= 75) {
                System.out.println(", Eligible for Exam");
            } else {
                System.out.println(", Not Eligible for Exam");
            }
        }

        sc.close();
    }
}
